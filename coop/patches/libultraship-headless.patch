diff --git a/src/fast/backends/gfx_headless.cpp b/src/fast/backends/gfx_headless.cpp
new file mode 100644
index 00000000..16e9d116
--- /dev/null
+++ b/src/fast/backends/gfx_headless.cpp
@@ -0,0 +1,80 @@
+// [COOP] See gfx_headless.h. The interpreter still walks every display list (matrices, vertices, texture loads),
+// so the game's draw pass behaves as usual; only the final GPU calls do nothing.
+#include "fast/backends/gfx_headless.h"
+#include "fast/Fast3dGui.h"
+#include "ship/Context.h"
+
+#include <map>
+#include <thread>
+
+namespace Fast {
+
+// Each backend defines its own ShaderProgram: ours only remembers its ids.
+struct ShaderProgram {
+    uint64_t id0;
+    uint64_t id1;
+};
+
+namespace {
+std::map<std::pair<uint64_t, uint64_t>, ShaderProgram> sShaders;
+} // namespace
+
+void GfxWindowBackendHeadless::Init(const char* gameName, const char* apiName, bool startFullScreen, uint32_t width,
+                                    uint32_t height, int32_t posX, int32_t posY) {
+    mWidth = width > 0 ? width : 320;
+    mHeight = height > 0 ? height : 240;
+    mStart = std::chrono::steady_clock::now();
+    mNextFrame = mStart;
+    mIsRunning = true;
+    // The GUI (ImGui) still runs its frames (the game's menus are never shown, but some code asks it things).
+    GuiWindowInitData impl = {};
+    impl.Backend = WindowBackend::FAST3D_HEADLESS;
+    std::dynamic_pointer_cast<Fast3dGui>(Ship::Context::GetRawInstance()->GetWindow()->GetGui())->Init(impl);
+}
+
+void GfxWindowBackendHeadless::Close() {
+    mIsRunning = false;
+}
+
+// Keeps the game at its own speed (20 logic frames per second) instead of the screen's refresh.
+void GfxWindowBackendHeadless::SwapBuffersBegin() {
+    using namespace std::chrono;
+    auto period = nanoseconds(1000000000LL / (mTargetFps > 0 ? mTargetFps : 20));
+    mNextFrame += period;
+    auto now = steady_clock::now();
+    if (mNextFrame < now - period) {
+        mNextFrame = now; // far behind (a slow frame): do not try to catch up
+    }
+    std::this_thread::sleep_until(mNextFrame);
+}
+
+double GfxWindowBackendHeadless::GetTime() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - mStart).count();
+}
+
+ShaderProgram* GfxRenderingAPIHeadless::CreateAndLoadNewShader(uint64_t shaderId0, uint64_t shaderId1) {
+    ShaderProgram& prg = sShaders[{ shaderId0, shaderId1 }];
+    prg = { shaderId0, shaderId1 };
+    return &prg;
+}
+
+ShaderProgram* GfxRenderingAPIHeadless::LookupShader(uint64_t shaderId0, uint64_t shaderId1) {
+    auto it = sShaders.find({ shaderId0, shaderId1 });
+    return it == sShaders.end() ? nullptr : &it->second;
+}
+
+void GfxRenderingAPIHeadless::ReadFramebufferToCPU(int fbId, uint32_t width, uint32_t height, uint16_t* rgba16Buf) {
+    std::fill(rgba16Buf, rgba16Buf + (size_t)width * height, (uint16_t)0);
+}
+
+std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>
+GfxRenderingAPIHeadless::GetPixelDepth(int fbId, const std::set<std::pair<float, float>>& coordinates) {
+    std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> out;
+    for (const auto& c : coordinates) {
+        out[c] = 0;
+    }
+    return out;
+}
+
+} // namespace Fast
+
